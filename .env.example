# Copy this file to .env and fill in real values. .env is git-ignored.
# Direct python CLI: process environment wins over .env.
# ./scripts/start_bot.sh: exports .env values, overriding the process environment.

# Telegram: bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Required: chat ids allowed to use the bot (comma-separated). Send the bot any
# message, then read chat.id from https://api.telegram.org/bot<token>/getUpdates
# (the bot will not start until at least one id is set).
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: override the default hosted Telegram setup helper.
# Unset = default helper (@BizcardSetupBot); empty = manual BotFather path.
# The helper does not store your bot token or access photos / your Google account.
# Its operator can re-retrieve your bot token; use setup-telegram --manual if you object.
# setup-telegram saves the verified bot token and allowed chat id automatically.
# BIZCARD_ONBOARDING_URL=https://your-setup-service.example.invalid

# Optional: chat id that receives health-check alerts (codex/claude or Google auth broken)
# Google alerts require this id. Only Apple permission alerts fall back to allowed chats.
# Apple alerts persist their last state/time; unchanged permission alerts repeat after 24h.
BIZCARD_ALERT_CHAT_ID=

# Parser: auto (openai when an API key is stored, else codex, else claude) | openai | codex | claude
# openai uses OPENAI_API_KEY below, else the file named by BIZCARD_OPENAI_ENV_FILE,
# otherwise only ~/.config/openai/credentials.env (no other project key files).
# BIZCARD_OPENAI_ENV_FILE=/absolute/path/to/your-openai.env
# When an API call fails the bot falls back to the codex/claude CLI.
# OPENAI_API_KEY=
# BIZCARD_PARSER=auto
# BIZCARD_OPENAI_MODEL=gpt-6-luna
# BIZCARD_REASONING_EFFORT=low
# Cross-check: with ANTHROPIC_API_KEY set, each card is also read by Claude Haiku
# in parallel; phones are merged and verified against the OCR text, and
# conflicting names/companies are flagged. BIZCARD_CROSSCHECK=off disables it.
# ANTHROPIC_API_KEY=
# BIZCARD_ANTHROPIC_MODEL=claude-haiku-5-5
# BIZCARD_CODEX_MODEL=gpt-5.6-luna
# BIZCARD_CLAUDE_MODEL=haiku
# BIZCARD_PARSER_TIMEOUT=90

# 만남 메모를 추가합니다. off면 메모 추가와 권한·대기 안내를 끕니다.
BIZCARD_MEETING_NOTE=on

# AI 비용 환산 환율과 사진 한 번의 인식 비용 안내 기준(원)입니다.
# CLI 대체 실행과 미지원 모델의 비용은 알 수 없어 경고하지 않습니다.
BIZCARD_USD_KRW=1335
BIZCARD_COST_WARN_KRW=2
# 주소 판독을 OCR과 비교합니다. off로 끕니다.
BIZCARD_ADDRESS_ARBITRATION=on

# Cards processed at the same time (album uploads, saves)
# BIZCARD_WORKERS=30
# 한 사진의 명함 2~4장을 장마다 나눠 읽습니다. off면 사진 전체를 1장으로 처리합니다.
# 분할 도우미 빌드에 Xcode Command Line Tools의 swiftc가 필요합니다.
BIZCARD_MULTICARD=on
# Minimum seconds between bot messages to one chat (Telegram throttles bursts)
# BIZCARD_TELEGRAM_INTERVAL=0.35

# Python interpreter that has cv2, numpy, PIL (default: python3 on PATH)
# BIZCARD_PYTHON=/path/to/python3

GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file   # gws key in ~/.config/gws/.encryption_key

# Contacts destination: google (default when unset, existing gws setup) | apple
# Run python -m bizcard_intake setup-contacts to choose a Mac account without
# a Google Cloud project. Enable Google Contacts in System Settings > Internet Accounts.
# BIZCARD_CONTACTS_BACKEND=apple
# macOS account container identifier, selected by setup-contacts; empty = default account.
# BIZCARD_APPLE_CONTAINER=

# 후속 연락 첫 알림까지의 일수. 기본 3일이며 0이면 알림을 끕니다.
# 업그레이드 후 저장을 완료한 명함부터 적용하며 기존 저장 명함은 제외합니다.
# 고정 인사말을 사용하므로 추가 AI 비용이 없습니다.
# BIZCARD_TZ 기준 10:00–18:59에 알립니다.
BIZCARD_FOLLOWUP_DAYS=3

# 후속 알림 시간대. 예: Asia/Seoul. 비우거나 잘못 지정하면 시스템 시간대를 사용합니다.
# KST 대신 Asia/Seoul을 사용합니다. 잘못된 값은 doctor에서 경고합니다.
BIZCARD_TZ=
